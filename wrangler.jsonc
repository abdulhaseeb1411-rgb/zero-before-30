{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zero-before-30",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
